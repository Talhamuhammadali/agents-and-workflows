<mxfile host="app.diagrams.net" type="device">
  <diagram name="Agentic System — Overview" id="arch-overview">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Worker boundary (ephemeral, gVisor) -->
        <mxCell id="work" value="Agent Worker (ephemeral)   ·   gVisor kernel-level isolation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B85450;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=center;fontColor=#B85450;fontStyle=1;fontSize=14;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="250" width="610" height="270" as="geometry" />
        </mxCell>

        <!-- Option sub-boundaries -->
        <mxCell id="opt1" value="Option 1 — Ephemeral sandbox (Modal / Daytona)&#10;one sandbox per session" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#F4F8FF;strokeColor=#6C8EBF;verticalAlign=top;align=center;fontColor=#3B5C86;fontStyle=1;fontSize=12;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="85" y="305" width="280" height="195" as="geometry" />
        </mxCell>
        <mxCell id="opt2" value="Option 2 — Fixed worker&#10;isolation at the tool level" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#F4F8FF;strokeColor=#6C8EBF;verticalAlign=top;align=center;fontColor=#3B5C86;fontStyle=1;fontSize=12;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="385" y="305" width="265" height="195" as="geometry" />
        </mxCell>

        <!-- Persistence boundary -->
        <mxCell id="persist" value="Persistent state — outside the worker · survives if a worker dies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6B8E23;strokeWidth=2;verticalAlign=top;align=center;fontColor=#4F6B12;fontStyle=1;fontSize=13;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="750" y="120" width="340" height="450" as="geometry" />
        </mxCell>
        <mxCell id="red" value="Redis — memory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8F0;strokeColor=#D79B00;verticalAlign=top;align=center;fontColor=#8A5A00;fontStyle=1;fontSize=13;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="775" y="170" width="290" height="240" as="geometry" />
        </mxCell>

        <!-- Chat UI -->
        <mxCell id="ui" value="Chat UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="190" y="40" width="180" height="50" as="geometry" />
        </mxCell>
        <!-- Backend API -->
        <mxCell id="api" value="API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="190" y="140" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- Redis contents -->
        <mxCell id="st" value="Short-term&#10;chat history (this conversation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="800" y="215" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lt" value="Long-term — cross-session&#10;preferences · solved problems · artifacts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="800" y="295" width="240" height="95" as="geometry" />
        </mxCell>

        <!-- NFS file system (outside worker) -->
        <mxCell id="nfs" value="NFS file system&#10;(workspace)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=13;boundedLbl=1;" vertex="1" parent="1">
          <mxGeometry x="810" y="420" width="220" height="120" as="geometry" />
        </mxCell>

        <!-- Option 1 contents -->
        <mxCell id="p1" value="Warm pool of ready workers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="110" y="370" width="230" height="36" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="Agent logic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="435" width="170" height="40" as="geometry" />
        </mxCell>

        <!-- Option 2 contents -->
        <mxCell id="a2" value="Agent logic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="435" y="400" width="165" height="40" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e_sse" value="Server-Sent Events (SSE)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;startArrow=block;strokeColor=#82B366;fontColor=#5A7D43;strokeWidth=2;fontSize=13;" edge="1" parent="1" source="ui" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_disp" value="dispatch agent run" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6C8EBF;fontColor=#3B5C86;strokeWidth=2;fontSize=13;" edge="1" parent="1" source="api" target="work">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_loadsave" value="load / save" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;startArrow=block;strokeColor=#D79B00;fontColor=#8A5A00;strokeWidth=2;fontSize=13;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.15;entryDx=0;entryDy=0;" edge="1" parent="1" source="api" target="red">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_mem" value="reads / writes memory" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;startArrow=block;strokeColor=#D79B00;fontColor=#8A5A00;strokeWidth=2;fontSize=13;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="work" target="red">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_mount" value="mounts filesystem" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;startArrow=block;strokeColor=#999999;fontColor=#666666;strokeWidth=2;fontSize=13;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="work" target="nfs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_p1a1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6C8EBF;" edge="1" parent="1" source="p1" target="a1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
